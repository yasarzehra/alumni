# =============================================================================
# Alumni Platform - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
# =============================================================================

# Application Settings
APP_NAME="Alumni Management Platform"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

# Database Configuration (MySQL / Docker)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=alumni_db
DB_USERNAME=alumni_user
DB_PASSWORD=alumni_secure_password

# MySQL Container Root Credentials
MYSQL_ROOT_PASSWORD=root_master_password

# Security & Secrets (Generate a secure 32+ character random key in production)
APP_KEY=base64:example_secret_key_change_in_production_32chars
JWT_SECRET=super_secret_jwt_signing_key_example

# Session & Cache Settings
SESSION_DRIVER=file
SESSION_LIFETIME=120

# CORS & Client Origins
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
